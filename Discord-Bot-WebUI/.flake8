[flake8]
max-line-length = 120
exclude =
    .git,
    __pycache__,
    venv,
    env,
    .tox,
    dist,
    migrations,
    .venv,
    static,
    templates

# Comments must live ABOVE the option, never inline inside the value.
#
# These used to be written as `E203,  # whitespace before ':'` on each line.
# flake8 7 parses every comma-separated token in `ignore` as a code and rejects
# '#' against '^[A-Z]{1,3}[0-9]{0,3}$', so flake8 CRASHED during config parsing
# before linting a single file:
#
#     ValueError: Error code '#' supplied to 'ignore' option does not match ...
#
# The CI `Run flake8` step carried `continue-on-error: true`, so that crash was
# swallowed on every run -- flake8 has never actually linted this repo. It only
# became visible when a narrow `--select=E9,F63,F7,F82` step was added WITHOUT
# continue-on-error, because a config crash fails before --select is even read.
#
# What each ignored code is:
#   E203 - whitespace before ':'                 (black formats it this way)
#   E266 - too many leading '#' for block comment
#   E501 - line too long                         (max-line-length above / black)
#   W503 - line break before binary operator     (black formats it this way)
#   F401 - imported but unused
#   F841 - local variable assigned but never used
ignore =
    E203,
    E266,
    E501,
    W503,
    F401,
    F841
